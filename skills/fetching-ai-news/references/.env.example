# Telegram Bot Token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID — send a message to your bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Local MCP server note:
# - The MCP server can start without these values when using send=false.
# - They are required only when the MCP tool sends to Telegram.
